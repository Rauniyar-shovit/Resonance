# Copy to .env and fill in. No real values belong in this file — it is committed.

# --- Database -----------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/resonance

# Public origin. Polar sends the customer back here after checkout.
APP_URL=http://localhost:3000

# --- Clerk --------------------------------------------------------------------
# Personal accounts are disabled; users must belong to an organization.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/dashboard

# --- Cloudflare R2 ------------------------------------------------------------
# Holds voice samples and generated audio. Never addressed from the browser.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- Chatterbox TTS -----------------------------------------------------------
CHATTERBOX_API_URL=https://your-chatterbox-host
CHATTERBOX_API_KEY=

# --- Polar --------------------------------------------------------------------
POLAR_ACCESS_TOKEN=
POLAR_SERVER=sandbox
POLAR_PRODUCT_ID=
POLAR_METER_VOICE_CREATION=
POLAR_METER_TTS_GENERATION=
POLAR_METER_TTS_PROPERTY=

# --- Sentry (optional locally) ------------------------------------------------
# Only needed to upload source maps at build time.
SENTRY_AUTH_TOKEN=
